          <mxGeometry height="36" width="137.4" x="1928.6" y="488.63" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这里，是不是可以，替换为，我们的，excel中的，两条曲线？横轴也自适应，纵轴也自适应，你试试看，自行调整，参考广泛的相关图；" vertex="1">
          <mxGeometry height="30" width="750" x="1550" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="星星标最高，虚线，也要；" vertex="1">
          <mxGeometry height="30" width="170" x="1852.49" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="其他的多余的文字不要擅自标" vertex="1">
          <mxGeometry height="30" width="180" x="2045.43" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这个先清空，就是框内曲线虚线等拿掉；图例留下；" vertex="1">
          <mxGeometry height="30" width="300" x="209.94" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这个，我们最新的一个实验，TAO2，效果是不是不错；你先把rlt clean4和tao2，加入我们那个excel；&lt;div&gt;往右加两列之类的，你看着办；然后，可视化几版这种框图曲线，每步成功率，5 10 15 20 30 40滑动平均，等等；&lt;/div&gt;&lt;div&gt;同样的，和之前头图一样，左边一大串很低的，拿掉；从150+步某步开始？好像是学生参与什么？总之你试试看，多画几版&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="670" x="740.44" y="-230" as="geometry" />
        </mxCell>
        <mxCell id="u-0KqjZahDCkQLiktz7o-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这几个图例的，w/ dvca，是不是后面都参考相关关系，标一下ours？" vertex="1">
          <mxGeometry height="30" width="390" x="-435" y="480" as="geometry" />
        </mxCell>
