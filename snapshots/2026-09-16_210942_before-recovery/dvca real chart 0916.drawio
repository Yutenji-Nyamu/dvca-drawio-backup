        <mxCell id="KZ8Z9uoA_Hjiv1DsV17u-126" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="合并进去图例吧，各方面调整下，风格对齐rlt该图，注意细节，间隔，字体，框线，等等" vertex="1">
